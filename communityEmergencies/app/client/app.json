{
  "expo": {
    "name": "Comm Alert",
    "slug": "Comm Alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "startup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": {
        "dark": "./assets/icons/ios-icon-dark.png",
        "light": "./assets/icons/ios-icon-default.png",
        "tinted": "./assets/icons/ios-icon-tinted.png"
      },
      "bundleIdentifier": "com.anonymous.startup"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "backgroundImage": "./assets/icons/android-icon-foreground.png",
        "monochromeImage": "./assets/icons/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.startup"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/ios-icon-default.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#235347",
          "dark": {
            "image": "./assets/icons/ios-icon-default.png",
            "backgroundColor": "#235347"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
